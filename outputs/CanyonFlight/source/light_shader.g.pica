; v34.02 night lights, geometry stage: each input point becomes a camera-
; facing square, at least minPx pixels wide (minPx = size code / 40), never
; smaller than the lamp (sizeParam.x = half size in metres). Points behind
; the near plane or outside 1.1x the screen are dropped here, so no vertex
; ever lands far off screen (the PICA200 rasterizer wraps those, v31.1).
; sizeParam: x = lamp half size (m), y = 1/440 (half pixel per metre of
; depth at 220 px focal length), z = 1.1 (screen guard), w = 1 (near limit).
; v1.1p16: lamps 2.5 px and wider get texture coordinates 0..1 across the square and the
; pass alpha-tests a disc texture, so they draw round; smaller ones get the disc centre
; on every corner and stay solid squares (a 2 px disc would lose pixels or vanish).
.gsh point c0
.fvec projection[4], sizeParam
.constf consts(0.0, 1.0, -1.0, 0.025)
.constf roundc(440.0, 2.5, 0.5, 0.0)
.out outpos position
.out outclr color
.out outtc texcoord0
.alias vpos v0
.alias vclr v1
.entry light_gmain
.proc light_gmain
 mov r0, vpos
 ; depth in front of the camera
 mov r3, -r0.zzzz
 cmp sizeParam.ww, lt, lt, r3.xx
 jmpc !cmp.x, done
 ; half size: max(lamp, depth * minPx / 440)
 mul r2.x, consts.w, vclr.w
 mul r2.x, sizeParam.y, r2.x
 mul r2.x, r2.x, r3.x
 max r2.x, sizeParam.x, r2.x
 ; centre in clip space, culled outside 1.1 x the screen
 dp4 r4.x, projection[0], r0
 dp4 r4.y, projection[1], r0
 dp4 r4.z, projection[2], r0
 dp4 r4.w, projection[3], r0
 max r5, r4, -r4
 mul r6, sizeParam.zzzz, r4.wwww
 cmp r5, gt, gt, r6
 jmpc cmp.x || cmp.y, done
 mov r9, vclr
 mov r9.w, consts.y
 ; width in pixels = 2 * half size / depth * 220 = half size * 440 / depth
 rcp r12.x, r3.x
 mul r12.x, r2.x, r12.x
 mul r12.x, roundc.x, r12.x
 ; r11.x = 0.5 when round (wider than 2.5 px), else 0: texture coordinates 0.5 -/+ r11.x
 slt r11.x, roundc.y, r12.x
 mul r11.x, roundc.z, r11.x
 add r13.x, roundc.z, -r11.x
 add r13.y, roundc.z, r11.x
 ; corners: (-h,-h) (h,-h) (-h,h) (h,h) in view space
 mov r7, r2.xxxx
 mov r8, r0
 add r8.x, r0.x, -r7.x
 add r8.y, r0.y, -r7.y
 mov r10.x, r13.x
 mov r10.y, r13.x
 setemit 0
 call light_corner
 emit
 mov r8, r0
 add r8.x, r0.x, r7.x
 add r8.y, r0.y, -r7.y
 mov r10.x, r13.y
 mov r10.y, r13.x
 setemit 1
 call light_corner
 emit
 mov r8, r0
 add r8.x, r0.x, -r7.x
 add r8.y, r0.y, r7.y
 mov r10.x, r13.x
 mov r10.y, r13.y
 setemit 2, prim
 call light_corner
 emit
 mov r8, r0
 add r8.x, r0.x, r7.x
 add r8.y, r0.y, r7.y
 mov r10.x, r13.y
 mov r10.y, r13.y
 setemit 0, inv prim
 call light_corner
 emit
done:
 end
.end
.proc light_corner
 dp4 outpos.x, projection[0], r8
 dp4 outpos.y, projection[1], r8
 dp4 outpos.z, projection[2], r8
 dp4 outpos.w, projection[3], r8
 mov outclr, r9
 mov outtc, r10
.end
