; v34.02 night lights, geometry stage: each input point becomes a camera-
; facing square, at least minPx pixels wide (minPx = size code / 40), never
; smaller than the lamp (sizeParam.x = half size in metres). Points behind
; the near plane or outside 1.1x the screen are dropped here, so no vertex
; ever lands far off screen (the PICA200 rasterizer wraps those, v31.1).
; sizeParam: x = lamp half size (m), y = 1/440 (half pixel per metre of
; depth at 220 px focal length), z = 1.1 (screen guard), w = 1 (near limit).
.gsh point c0
.fvec projection[4], sizeParam
.constf consts(0.0, 1.0, -1.0, 0.025)
.out outpos position
.out outclr color
.alias vpos v0
.alias vclr v1
.entry light_gmain
.proc light_gmain
 mov r0, vpos
 ; depth in front of the camera
 mov r3, -r0.zzzz
 cmp sizeParam.ww, lt, lt, r3.xx
 jmpc !cmp.x, done
 ; half size: max(lamp, depth * minPx / 440)
 mul r2.x, consts.w, vclr.w
 mul r2.x, sizeParam.y, r2.x
 mul r2.x, r2.x, r3.x
 max r2.x, sizeParam.x, r2.x
 ; centre in clip space, culled outside 1.1 x the screen
 dp4 r4.x, projection[0], r0
 dp4 r4.y, projection[1], r0
 dp4 r4.z, projection[2], r0
 dp4 r4.w, projection[3], r0
 max r5, r4, -r4
 mul r6, sizeParam.zzzz, r4.wwww
 cmp r5, gt, gt, r6
 jmpc cmp.x || cmp.y, done
 mov r9, vclr
 mov r9.w, consts.y
 ; corners: (-h,-h) (h,-h) (-h,h) (h,h) in view space
 mov r7, r2.xxxx
 mov r8, r0
 add r8.x, r0.x, -r7.x
 add r8.y, r0.y, -r7.y
 setemit 0
 call light_corner
 emit
 mov r8, r0
 add r8.x, r0.x, r7.x
 add r8.y, r0.y, -r7.y
 setemit 1
 call light_corner
 emit
 mov r8, r0
 add r8.x, r0.x, -r7.x
 add r8.y, r0.y, r7.y
 setemit 2, prim
 call light_corner
 emit
 mov r8, r0
 add r8.x, r0.x, r7.x
 add r8.y, r0.y, r7.y
 setemit 0, inv prim
 call light_corner
 emit
done:
 end
.end
.proc light_corner
 dp4 outpos.x, projection[0], r8
 dp4 outpos.y, projection[1], r8
 dp4 outpos.z, projection[2], r8
 dp4 outpos.w, projection[3], r8
 mov outclr, r9
.end
